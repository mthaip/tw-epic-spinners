{
  "name": "tw-epic-spinners",
  "version": "2.0.0-beta.1",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "llms.txt"
  ],
  "description": "20 composable pure-CSS loading spinners for Tailwind CSS v3 and v4. Add named parts; CSS automatically adapts layout and animation to their count.",
  "author": "mthaip <fanmt.fmt@gmail.com>",
  "homepage": "https://tw-epic-spinners.mthaip.com",
  "url": "https://github.com/mthaip/tw-epic-spinners",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mthaip/tw-epic-spinners.git"
  },
  "keywords": [
    "tailwindcss",
    "tailwindcss-plugin",
    "tailwind-plugin",
    "tailwind",
    "tailwindcss-v4",
    "tailwindcss-v3",
    "spinner",
    "spinners",
    "loading-spinner",
    "loader",
    "loading",
    "loading-indicator",
    "css-spinner",
    "css-animation",
    "pure-css",
    "no-js",
    "vue",
    "react",
    "svelte",
    "astro",
    "nextjs",
    "nuxt",
    "epic-spinners",
    "tw-epic-spinners",
    "ui",
    "frontend",
    "plugin"
  ],
  "scripts": {
    "lint": "eslint src",
    "npm:build:readme": "node scripts/build-readme.mjs",
    "npm:build": "npm run npm:build:readme && rm -rf dist && vite build -c ./vite.config.ts && node scripts/build-package.mjs",
    "prepare": "node scripts/build-readme.mjs",
    "test": "yarn npm:build && yarn --cwd tests/tailwind3 install --frozen-lockfile && node --test scripts/*.test.mjs",
    "npm:pack": "yarn npm:build && npm pack ./dist",
    "npm:publish": "yarn npm:build && npm publish ./dist"
  },
  "peerDependencies": {
    "tailwindcss": "^3.0.0 || ^4.0.0"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vue/language-core": "^3.3.1",
    "eslint": "10.4.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vite-plugin-dts": "^5.0.1"
  },
  "packageManager": "yarn@1.22.22",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "private": true,
  "sideEffects": false,
  "bugs": {
    "url": "https://github.com/mthaip/tw-epic-spinners/issues"
  }
}
